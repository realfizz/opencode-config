{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "snapshot": true,
  "experimental": {
    "openTelemetry": false,
    "batch_tool": true
  },
  "tools": {
    "websearch": true
  },
  "lsp": false,
  "instructions": [
    "AGENTS.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "dist/**"
    ]
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:EXA_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "oauth": false
    },
    "ida_pro_mcp_gui": {
      "type": "remote",
      "url": "http://localhost:13337/mcp",
      "enabled": true,
      "oauth": false
    }
  },
  "provider": {
    "xai": {
      "models": {
        "grok-composer-2.5-fast": {
          "name": "Composer 2.5 Fast"
        },
        "grok-build-0.1": {
          "name": "Grok Build"
        }
      }
    }
  }
}
