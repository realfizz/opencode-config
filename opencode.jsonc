{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "snapshots": true,
  "lsp": false,
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*--no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git commit*--no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git push*--no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git merge*--no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git *core.hooksPath=/dev/null*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "dist/**"
    ]
  },
  "mcp": {
    "servers": {
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "Authorization": "Bearer {env:EXA_API_KEY}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
        }
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "ida_pro_mcp_gui": {
        "type": "remote",
        "url": "http://localhost:13337/mcp"
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "oauth": {}
      }
    }
  },
  "providers": {
    "xai": {
      "models": {
        "grok-composer-2.5-fast": {
          "name": "Composer 2.5 Fast"
        },
        "grok-build-0.1": {
          "name": "Grok Build"
        }
      }
    }
  },
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "dev",
      "description": "OpenCode source. Use when debugging opencode itself, config, tools, TUI, agents, or runtime — not for normal app work."
    },
    "opentui": {
      "repository": "anomalyco/opentui",
      "branch": "main",
      "description": "OpenTUI source. Use for TUI primitives, rendering, and opencode UI layer details."
    },
    "bun": {
      "repository": "oven-sh/bun",
      "branch": "main",
      "description": "Bun runtime/source. Prefer this over Node-shaped guesses for Bun APIs, bundler, and test runner."
    },
    "better-auth": {
      "repository": "better-auth/better-auth",
      "branch": "main",
      "description": "Better Auth source of truth. Use for auth APIs, plugins, sessions — do not invent APIs."
    },
    "drizzle": {
      "repository": "drizzle-team/drizzle-orm",
      "branch": "main",
      "description": "Drizzle ORM source. Use for schema, query builder, and driver APIs — do not invent."
    },
    "react-email": {
      "repository": "resend/react-email",
      "branch": "canary",
      "description": "React Email source. Use for components, rendering, and packaging emails."
    },
    "paykit": {
      "repository": "getpaykit/paykit",
      "branch": "main",
      "description": "PayKit (paykit.sh) source. Use for billing, plans, usage, Stripe webhooks — do not invent APIs."
    },
    "hono": {
      "repository": "honojs/hono",
      "branch": "main",
      "description": "Hono source. Use when you need exact middleware, context, or adapter behavior from source."
    }
  }
}
