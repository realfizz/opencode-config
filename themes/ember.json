{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#000000",
    "bgPanel": "#0a0a0a",
    "bgElement": "#141414",
    "line": "#1a1a1a",
    "fg": "#ffffff",
    "fgDim": "#d4d4d4",
    "fgMute": "#a3a3a3",
    "orange": "#f97316",
    "orangeSoft": "#fb923c",
    "orangeHot": "#fdba74",
    "red": "#ef4444",
    "redSoft": "#f87171"
  },
  "theme": {
    "primary": {
      "dark": "orange",
      "light": "orange"
    },
    "secondary": {
      "dark": "fgMute",
      "light": "fgMute"
    },
    "accent": {
      "dark": "orange",
      "light": "orange"
    },
    "error": {
      "dark": "red",
      "light": "red"
    },
    "warning": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "success": {
      "dark": "orange",
      "light": "orange"
    },
    "info": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "text": {
      "dark": "fg",
      "light": "bg"
    },
    "textMuted": {
      "dark": "fgDim",
      "light": "#404040"
    },
    "background": {
      "dark": "bg",
      "light": "fg"
    },
    "backgroundPanel": {
      "dark": "bgPanel",
      "light": "#f5f5f5"
    },
    "backgroundElement": {
      "dark": "bgElement",
      "light": "#eeeeee"
    },
    "border": {
      "dark": "line",
      "light": "#e5e5e5"
    },
    "borderActive": {
      "dark": "orange",
      "light": "orange"
    },
    "borderSubtle": {
      "dark": "bgPanel",
      "light": "#f0f0f0"
    },
    "diffAdded": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "diffRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffContext": {
      "dark": "fgMute",
      "light": "fgMute"
    },
    "diffHunkHeader": {
      "dark": "fgMute",
      "light": "fgMute"
    },
    "diffHighlightAdded": {
      "dark": "orange",
      "light": "orange"
    },
    "diffHighlightRemoved": {
      "dark": "redSoft",
      "light": "red"
    },
    "diffAddedBg": {
      "dark": "#1a0f08",
      "light": "#fff7ed"
    },
    "diffRemovedBg": {
      "dark": "#1a0808",
      "light": "#fef2f2"
    },
    "diffContextBg": {
      "dark": "bg",
      "light": "fg"
    },
    "diffLineNumber": {
      "dark": "fgMute",
      "light": "fgMute"
    },
    "diffAddedLineNumberBg": {
      "dark": "#1a0f08",
      "light": "#fff7ed"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#1a0808",
      "light": "#fef2f2"
    },
    "markdownText": {
      "dark": "fg",
      "light": "bg"
    },
    "markdownHeading": {
      "dark": "orange",
      "light": "orange"
    },
    "markdownLink": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "markdownLinkText": {
      "dark": "orangeHot",
      "light": "orange"
    },
    "markdownCode": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "markdownBlockQuote": {
      "dark": "fgMute",
      "light": "fgMute"
    },
    "markdownEmph": {
      "dark": "orangeHot",
      "light": "orange"
    },
    "markdownStrong": {
      "dark": "fg",
      "light": "bg"
    },
    "markdownHorizontalRule": {
      "dark": "line",
      "light": "#e5e5e5"
    },
    "markdownListItem": {
      "dark": "orange",
      "light": "orange"
    },
    "markdownListEnumeration": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "markdownImage": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "markdownImageText": {
      "dark": "orange",
      "light": "orange"
    },
    "markdownCodeBlock": {
      "dark": "fgDim",
      "light": "bg"
    },
    "syntaxComment": {
      "dark": "fgMute",
      "light": "fgMute"
    },
    "syntaxKeyword": {
      "dark": "orange",
      "light": "orange"
    },
    "syntaxFunction": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "syntaxVariable": {
      "dark": "fg",
      "light": "bg"
    },
    "syntaxString": {
      "dark": "orangeHot",
      "light": "orange"
    },
    "syntaxNumber": {
      "dark": "orangeSoft",
      "light": "orange"
    },
    "syntaxType": {
      "dark": "orangeHot",
      "light": "orangeSoft"
    },
    "syntaxOperator": {
      "dark": "fgDim",
      "light": "bg"
    },
    "syntaxPunctuation": {
      "dark": "fgDim",
      "light": "fgMute"
    }
  }
}
